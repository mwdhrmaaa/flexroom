{
  "name": "flexroom",
  "version": "1.0.0",
  "private": true,
  "description": "Premium Gaming Achievements Showcase & Trophy Card Generator",
  "type": "module",
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "dev": "node -e \"const http=require('http'),fs=require('fs'),path=require('path');http.createServer((req,res)=>{let f=path.join(process.cwd(),req.url==='/'?'index.html':req.url);fs.readFile(f,(err,data)=>{if(err){res.writeHead(404);res.end('Not Found');}else{res.writeHead(200);res.end(data);}})}).listen(8080,()=>console.log('Flexroom dev running at http://localhost:8080'));\""
  },
  "keywords": [
    "gaming",
    "achievements",
    "trophy-card",
    "canvas-export"
  ],
